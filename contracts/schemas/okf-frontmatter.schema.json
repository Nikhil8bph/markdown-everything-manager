{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localhost/schemas/okf-frontmatter.schema.json",
  "title": "MarkCraft supported OKF frontmatter subset",
  "description": "Metadata exposed for editing; the API stores complete Markdown and preserves other valid YAML fields.",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "status": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "items": { "type": "string" } },
    "resource": { "type": "string" },
    "stale_after": { "type": "string" },
    "generated": {
      "type": "object",
      "properties": {
        "by": { "type": "string" },
        "model": { "type": "string" }
      },
      "additionalProperties": true
    },
    "verified": {
      "type": "object",
      "properties": {
        "by": { "type": "string" },
        "at": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
